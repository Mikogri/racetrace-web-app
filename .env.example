# Values below are read only by the Vite development server and are not bundled
# into browser JavaScript. In production, expose /api through a trusted reverse
# proxy that adds the same bearer token server-side.
API_PROXY_TARGET=http://127.0.0.1:5017
API_READ_SECRET=dev-read-secret

# Leave empty when the frontend and API share an origin through a reverse proxy.
VITE_API_BASE_URL=
VITE_API_TIMEOUT_MS=12000
